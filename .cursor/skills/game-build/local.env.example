# 复制为 local.env 后填写本机实际值。local.env 不提交。

# Cocos Creator 可执行文件
# macOS 示例：/Applications/Cocos/Creator/3.8.8/CocosCreator.app/Contents/MacOS/CocosCreator
COCOS_CREATOR=""

# 微信小游戏 AppID。测试号不能当正式包
WECHAT_APPID=""

# 微信开发者工具
# macOS 示例：/Applications/wechatwebdevtools.app
WECHAT_DEVTOOLS=""

# 远程资源服务器地址（启用远程资源时填写，需在微信后台配置为合法域名）
REMOTE_SERVER_ADDRESS=""
